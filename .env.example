# Copy to .env and fill in. Never commit .env.

# ---- PayPal ---------------------------------------------------------------
# mock    : no network, clearly-labelled fake PayPal (default; full demo works)
# sandbox : real calls to https://api-m.sandbox.paypal.com
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Public URL PayPal redirects back to after vault approval (sandbox mode).
LOOPREMIT_BASE_URL=http://localhost:8000

# Optional: override payee payout receivers with your sandbox business accounts.
# PAYEE_EMAIL_SCSA=school-business@example.com
# PAYEE_EMAIL_LIWANAG_POWER=power-business@example.com
# PAYEE_EMAIL_BOTIKA=pharmacy-business@example.com
# PAYEE_EMAIL_CASA_MARIA=landlord-business@example.com

# ---- AI model (bill intake) -----------------------------------------------
# auto    : use the AI model when either key below is set, else offline fixtures
# ai      : always call the AI model (fails without a key)
# offline : labelled fixture extractions only (tests, keyless demo)
LOOPREMIT_INTAKE_MODE=auto
# Set one. If both are set, ANTHROPIC_API_KEY wins.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# LOOPREMIT_OPENROUTER_MODEL=<any vision model with strict JSON schema support>

# ---- FX -------------------------------------------------------------------
# Set to 1 to skip frankfurter.app and use the cached/fallback USD->PHP rate.
LOOPREMIT_FX_OFFLINE=0
LOOPREMIT_FX_FALLBACK_RATE=58.50

# ---- Storage --------------------------------------------------------------
LOOPREMIT_DATA_DIR=var
